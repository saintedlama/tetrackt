Output screenshots/synth-patchbank.gif

Set Shell "powershell"
Set FontSize 13
Set Width 1400
Set Height 800
Set TypingSpeed 100ms

Sleep 100ms

Type ".\tetrackt.exe"
Enter

Sleep 3000ms

# Switch to the synth screen
Ctrl+t
Sleep 800ms

# --- Env1: adjust Attack, Decay, Sustain ---
Ctrl+Right
Sleep 600ms

# Attack — select and increase
Right
Sleep 200ms
Right
Sleep 200ms
Right
Sleep 400ms

# Decay — next parameter
Down
Sleep 300ms
Right
Sleep 200ms
Right
Sleep 400ms

# Sustain
Down
Sleep 300ms
Left
Sleep 200ms
Left
Sleep 400ms

# --- LFO1 ---
Right
Sleep 600ms

# Depth
Sleep 300ms
Right
Sleep 200ms
Right
Sleep 400ms

# Rate
Down
Sleep 300ms
Right
Sleep 200ms
Right
Sleep 200ms
Right
Sleep 800ms

Screenshot screenshots/synth.png

# --- Patch bank ---
Type "b"
Sleep 800ms

Screenshot screenshots/synth-patchbank.png

# Cycle through categories with Right arrow
Right
Sleep 300ms
Right
Sleep 300ms
Right
Sleep 300ms
Right
Sleep 300ms
Right
Sleep 300ms
Right
Sleep 300ms
Right
Sleep 300ms

# Apply the selected patch
Enter
Sleep 800ms
